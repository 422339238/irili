<div class="login-container">
  <div class="login-card">
    <h1 class="login-title">✓ Rili</h1>
    <p class="login-subtitle">Sign in to manage your tasks</p>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="Enter your username" required autofocus>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter your password" required>
      </div>
      <% if (showCaptcha) { %>
        <div class="form-group">
          <label for="captcha">验证码：<%= captchaQuestion %></label>
          <input type="text" id="captcha" name="captcha" placeholder="请输入计算结果" required autocomplete="off">
        </div>
      <% } %>
      <button type="submit" class="btn-login">Sign In</button>
    </form>
  </div>
</div>
