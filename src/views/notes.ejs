<%
  const dayNames = ['日', '一', '二', '三', '四', '五', '六'];

  // 月份背景色 — 12个月循环
  const monthColors = [
    'rgba(255,107,107,0.10)', // 1月 红
    'rgba(255,146,43,0.10)',  // 2月 橙
    'rgba(255,217,61,0.10)',  // 3月 黄
    'rgba(76,209,55,0.10)',   // 4月 绿
    'rgba(72,219,251,0.10)',  // 5月 青
    'rgba(52,152,219,0.10)',  // 6月 蓝
    'rgba(155,89,182,0.10)',  // 7月 紫
    'rgba(253,121,168,0.10)', // 8月 粉
    'rgba(0,210,211,0.10)',   // 9月 碧
    'rgba(232,67,147,0.10)',  // 10月 玫红
    'rgba(108,92,231,0.10)',  // 11月 靛
    'rgba(162,155,254,0.10)'  // 12月 淡紫
  ];

  const monthBorderColors = [
    'rgba(255,107,107,0.35)',
    'rgba(255,146,43,0.35)',
    'rgba(255,217,61,0.35)',
    'rgba(76,209,55,0.35)',
    'rgba(72,219,251,0.35)',
    'rgba(52,152,219,0.35)',
    'rgba(155,89,182,0.35)',
    'rgba(253,121,168,0.35)',
    'rgba(0,210,211,0.35)',
    'rgba(232,67,147,0.35)',
    'rgba(108,92,231,0.35)',
    'rgba(162,155,254,0.35)'
  ];

  function getMonthFromDate(dateStr) {
    return parseInt(dateStr.split('-')[1], 10);
  }

  function dayLabel(dateStr) {
    const parts = dateStr.split('-');
    const m = parseInt(parts[1], 10);
    const d = parseInt(parts[2], 10);
    const dt = new Date(parseInt(parts[0], 10), m - 1, d);
    const weekday = dayNames[dt.getDay()];
    const bgColor = monthBorderColors[m - 1] || '#b8860b';
    return '<span style="background-color:' + bgColor + ';color:#fff;padding:0.1em 0.4em;border-radius:3px;">' + m + '月</span> ' + d + '日 星期' + weekday;
  }

  function getEntryMonthBg(dateStr) {
    const m = getMonthFromDate(dateStr);
    return monthColors[m - 1] || 'transparent';
  }

  function getEntryMonthBorder(dateStr) {
    const m = getMonthFromDate(dateStr);
    return monthBorderColors[m - 1] || 'transparent';
  }
%>

<div class="app-layout theme-apple">
  <div class="theme-orb theme-orb-a" aria-hidden="true"></div>
  <div class="theme-orb theme-orb-b" aria-hidden="true"></div>
  <div class="theme-orb theme-orb-c" aria-hidden="true"></div>

  <div class="notes-wrapper">
    <div class="notes-topbar">
      <div class="notes-topbar-left">
        <a href="/" class="kanban-back-link">← 任务列表</a>
        <a href="/kanban" class="kanban-back-link">看板</a>
        <h1 class="kanban-title">笔记</h1>
      </div>
      <div class="notes-topbar-right">
        <button type="button" class="btn-save notes-new-btn" id="notesNewBtn">+ 记录笔记</button>
        <span class="month-label">全部笔记 (<%= typeof totalEntries !== 'undefined' ? totalEntries : entries.length %>)</span>
        <button type="button" class="btn-view-toggle" id="viewToggleBtn" title="切换视图模式">
          <span id="viewToggleLabel">瀑布流</span>
        </button>
      </div>
    </div>

    <div class="settings-modal-overlay hidden" id="notesAddOverlay">
      <div class="settings-modal calendar-quick-add-modal" role="dialog" aria-modal="true">
        <div class="settings-modal-header">
          <h3>记录笔记</h3>
          <button type="button" class="settings-modal-close" id="notesAddCloseBtn" aria-label="关闭">×</button>
        </div>
        <div class="settings-modal-body">
          <form method="POST" action="/notes" class="calendar-quick-add-form" id="notesAddForm">
            <input type="hidden" name="month" value="<%= currentMonth %>">
            <input type="hidden" name="client_time" value="" id="notesAddClientTime">
            <input type="hidden" name="date" value="<%= today %>" id="notesAddDateInput">
            <textarea name="content" rows="4" class="notes-textarea" placeholder="记录你的想法..." required id="notesAddContentInput"></textarea>
            <div class="calendar-quick-add-actions">
              <button type="submit" class="btn-save">保存</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="notes-timeline" id="notesTimeline">
      <% if (entries.length === 0) { %>
        <div class="notes-empty">
          <p>暂无笔记</p>
          <p class="empty-hint">在上方记录你的第一条想法！</p>
        </div>
      <% } else { %>

        <!-- 瀑布流模式容器 -->
        <div id="waterfallContainer" class="notes-waterfall-container" style="display:none;">
          <div id="waterfallList" class="notes-waterfall-list">
            <!-- 由 JS 动态渲染 -->
          </div>
          <div id="waterfallLoader" class="notes-waterfall-loader" style="display:none;">
            <span class="loader-spinner"></span> 加载中...
          </div>
          <div id="waterfallEnd" class="notes-waterfall-end" style="display:none;">
            — 已加载全部笔记 —
          </div>
        </div>

        <!-- 分页模式容器 -->
        <div id="paginationContainer">
          <div id="notesListContainer">
            <% var lastDate = ''; %>
            <% entries.forEach(function(item) { %>
              <% if (item.date !== lastDate) { lastDate = item.date; %>
                <div class="notes-day-header" data-date="<%= item.date %>" style="border-left: 3px solid <%= getEntryMonthBorder(item.date) %>;">
                  <span class="notes-day-title"><%- dayLabel(item.date) %></span>
                </div>
              <% } %>
              <div class="note-entry" style="background: <%= getEntryMonthBg(item.date) %>; border-left: 3px solid <%= getEntryMonthBorder(item.date) %>;">
                <div class="note-display" id="note-display-<%= item.date %>-<%= item.noteIndex %>">
                  <% if (item.entry.content) { %>
                    <div class="note-content"><%= item.entry.content %></div>
                  <% } %>
                  <div class="note-footer">
                    <div class="note-footer-left">
                      <form method="POST" action="/notes/<%= item.date %>/delete" class="inline-form note-delete-form">
                        <input type="hidden" name="month" value="<%= currentMonth %>">
                        <input type="hidden" name="noteIndex" value="<%= item.noteIndex %>">
                        <button type="button" class="btn-icon btn-delete" title="删除" onclick="if(confirm('确定删除这条笔记？'))this.closest('form').submit()">✕</button>
                      </form>
                    </div>
                    <div class="note-footer-right">
                      <% if (item.entry.time) { %>
                        <span class="note-time"><%= item.entry.time %></span>
                      <% } %>
                      <div class="note-actions">
                        <button type="button" class="btn-icon btn-edit" onclick="toggleNoteEdit('<%= item.date %>', <%= item.noteIndex %>)" title="编辑">✎</button>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="note-edit-form hidden" id="note-edit-<%= item.date %>-<%= item.noteIndex %>">
                  <form method="POST" action="/notes/<%= item.date %>/update">
                    <input type="hidden" name="month" value="<%= currentMonth %>">
                    <input type="hidden" name="noteIndex" value="<%= item.noteIndex %>">
                    <textarea name="content" rows="4" class="notes-textarea notes-edit-textarea" required><%= item.entry.content %></textarea>
                    <div class="notes-add-row notes-add-actions">
                      <button type="submit" class="btn-save">保存</button>
                    </div>
                  </form>
                </div>
              </div>
            <% }); %>
          </div>

          <% if (totalPages > 1) { %>
            <div class="notes-pagination" style="display:flex;justify-content:center;align-items:center;gap:0.75rem;padding:1.2rem 0;">
              <% if (page > 1) { %>
                <a href="/notes?page=<%= page - 1 %>" class="btn-nav">← 上一页</a>
              <% } %>
              <span style="font-size:0.9rem;color:#888;"><%= page %> / <%= totalPages %></span>
              <% if (page < totalPages) { %>
                <a href="/notes?page=<%= page + 1 %>" class="btn-nav">下一页 →</a>
              <% } %>
            </div>
          <% } %>
        </div>

      <% } %>
    </div>
  </div>
</div>

